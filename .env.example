# Copie ce fichier en .env.local pour lancer en local, et mets les mêmes variables dans Vercel.
# Ne commite JAMAIS .env.local : il est ignoré par git.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète (service_role / sb_secret_…) : serveur uniquement, jamais dans le navigateur ni sur GitHub
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# Adresse publique de l'app (laisse vide en local, mets https://ton-app.vercel.app en ligne)
NEXT_PUBLIC_SITE_URL=
# Domaine autorisé à se connecter (doit correspondre à public.is_member() dans 01-schema.sql)
ALLOWED_EMAIL_DOMAIN=sciencespo.fr
# Adresse affichée sur la page de confidentialité (facultatif)
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Synchro Google Drive (voir README, section « Synchro Drive ») ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Dossier du Drive où l'app crée les Google Docs des documents (identifiant dans l'URL du dossier)
DRIVE_DOCS_FOLDER_ID=
# Secret partagé avec pg_cron (n'importe quelle longue chaîne aléatoire : openssl rand -hex 32)
CRON_SECRET=

# --- Réglages facultatifs ---
# Expression régulière (insensible à la casse) : tout fichier ou dossier dont le nom correspond est ignoré, avec son contenu
EXCLUDED_DRIVE_NAMES=
# Taille maximale d'un fichier ajouté depuis l'app, en Mo (Vercel refuse plus de 4,5 Mo par requête)
UPLOAD_MAX_MB=4
